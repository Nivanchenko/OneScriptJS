{
  "name": "onescriptjs",
  "displayName": "OneScriptJS",
  "description": "OneScriptJS (.osjs): подсветка, диагностика, автодополнение, hover, semantic tokens и переходы через LSP-сервер; блоки script[type=\"text/osjs\"] в HTML — по настройке.",
  "version": "0.2.0",
  "publisher": "onescriptjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nivanchenko/OneScriptJS"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "osjs",
    "onescriptjs",
    "bsl",
    "1c"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:osjs",
    "onLanguage:html",
    "onCommand:onescriptjs.restartServer",
    "onCommand:onescriptjs.showOutput",
    "onDebugResolve:osjs",
    "onDebugInitialConfigurations"
  ],
  "contributes": {
    "languages": [
      {
        "id": "osjs",
        "aliases": [
          "OneScriptJS",
          "osjs"
        ],
        "extensions": [
          ".osjs"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "osjs",
        "scopeName": "source.osjs",
        "path": "./syntaxes/osjs.tmLanguage.json"
      },
      {
        "scopeName": "osjs.embedded.injection",
        "path": "./syntaxes/osjs-embedded.tmLanguage.json",
        "injectTo": [
          "text.html.basic"
        ],
        "injectionSelector": "L:text.html.basic - (comment.block, meta.embedded)",
        "embeddedLanguages": {
          "meta.embedded.block.osjs": "osjs"
        }
      }
    ],
    "commands": [
      {
        "command": "onescriptjs.restartServer",
        "title": "OneScriptJS: Restart Language Server"
      },
      {
        "command": "onescriptjs.showOutput",
        "title": "OneScriptJS: Show Output"
      }
    ],
    "breakpoints": [
      {
        "language": "osjs"
      }
    ],
    "debuggers": [
      {
        "type": "osjs",
        "label": "OneScriptJS (BSL)",
        "languages": [
          "osjs",
          "html"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Файл .osjs для запуска (абсолютный или относительно cwd).",
                "default": "${file}"
              },
              "cwd": {
                "type": "string",
                "description": "Рабочий каталог запуска.",
                "default": "${workspaceFolder}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Остановиться на первом исполняемом операторе.",
                "default": false
              }
            }
          },
          "attach": {
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "description": "URL страницы с OneScriptJS или блоком <script type=\"text/osjs\">."
              },
              "webRoot": {
                "type": "string",
                "description": "Корень рабочей области для сопоставления URL и файлов.",
                "default": "${workspaceFolder}"
              },
              "port": {
                "type": "number",
                "description": "Порт WebSocket-сервера адаптера.",
                "default": 9229
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Остановиться на первом исполняемом операторе.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "osjs",
            "request": "launch",
            "name": "OneScriptJS: запуск файла",
            "program": "${file}",
            "cwd": "${workspaceFolder}"
          },
          {
            "type": "osjs",
            "request": "attach",
            "name": "OneScriptJS: браузер",
            "url": "http://localhost:5173/examples/hello.html",
            "webRoot": "${workspaceFolder}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "OneScriptJS: запуск файла",
            "description": "Запустить текущий .osjs под отладчиком OneScriptJS",
            "body": {
              "type": "osjs",
              "request": "launch",
              "name": "OneScriptJS: запуск файла",
              "program": "${file}",
              "cwd": "${workspaceFolder}",
              "stopOnEntry": false
            }
          },
          {
            "label": "OneScriptJS: браузер",
            "description": "Подключиться к странице с OneScriptJS (WebSocket)",
            "body": {
              "type": "osjs",
              "request": "attach",
              "name": "OneScriptJS: браузер",
              "url": "http://localhost:5173/examples/hello.html",
              "webRoot": "${workspaceFolder}"
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "OneScriptJS",
      "properties": {
        "onescriptjs.embeddedInHtml": {
          "type": "boolean",
          "default": true,
          "description": "Обслуживать блоки <script type=\"text/osjs\"> в HTML-документах (embedded-режим LSP-сервера)."
        },
        "onescriptjs.trace": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Уровень трассировки LSP-клиента в Output-канале «OneScriptJS»."
        }
      }
    }
  }
}
