// Пример для ручной проверки редакторных инструментов `.osjs`.
// Откройте файл в LSP-клиенте с нашим сервером (см. README / quickstart спеки 014).

Перем Счётчик;

#Область Модель

Функция Сложить(Знач А, Знач Б)
  Возврат А + Б;
КонецФункции

Процедура Увеличить(Знач НаСколько = 1)
  Счётчик = Счётчик + НаСколько;
КонецПроцедуры

#КонецОбласти

#Область Сценарий

Асинх Процедура Демонстрация()
  Сообщить("Счётчик до: " + Счётчик);
  Увеличить(2);
  Ждать Приостановить(10);
  Сообщить("Сложить(2, 3) = " + Сложить(2, 3));
  Сообщить("Счётчик после: " + Счётчик);
КонецПроцедуры

Демонстрация();

#КонецОбласти
