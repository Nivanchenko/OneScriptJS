// Ручная проверка редакторных возможностей OneScriptJS в VS Code для .osjs.
// Форматтера в проекте нет — проверяются подсветка, комментирование, скобки,
// фолдинг, word pattern и LSP-функции.
// Как проверять: см. specs/018-embedded-language-mode/quickstart.md и 014 quickstart.

#Область КлючевыеСловаИОператоры

Перем Счётчик;
Перем Коллекция;

&Аннотация
Процедура ПроверитьКлючевыеСлова(Знач Параметр = 1)
  Если Параметр > 0 И Параметр <> 2 Тогда       // ключевые слова, операторы
    Счётчик = Счётчик + Параметр;
  ИначеЕсли Параметр = 0 Или Параметр < -1 Тогда
    Счётчик = 0;
  Иначе
    Счётчик = ?(Параметр = 2, 10, 20);           // тернарный оператор
  КонецЕсли;

  Для Индекс = 1 По 3 Цикл                      // цикл со счётчиком
    Счётчик = Счётчик + Индекс;
  КонецЦикла;

  Для Каждого Элемент Из Коллекция Цикл          // цикл по коллекции
    Прервать;
  КонецЦикла;

  Пока Счётчик > 0 Цикл
    Счётчик = Счётчик - 1;
    Продолжить;
  КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область Литералы

Функция ПроверитьЛитералы()
  Число = 12345 + 0.5;                          // числа
  Строка = "обычная строка";                    // строка
  Многострочная = "первая строка
                  |вторая строка
                  |третья строка";              // строки с | (фолдинг/подсветка)
  Дата = '20260131';                            // дата
  Пустой = Неопределено;                        // константы
  Ноль = Null;
  Истина1 = Истина;
  Ложь1 = Ложь;
  Возврат Число + СтрДлина(Строка) + СтрДлина(Многострочная);
КонецФункции

#КонецОбласти

#Область ОшибкиИАннотации

Процедура ПроверитьИсключения()
  Попытка
    ВызватьИсключение "тест";
  Исключение
    ВызватьИсключение;                           // перевыброс
  КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область Асинхронность

Асинх Функция ЗагрузитьДанные(Знач Задержка = 0)
  Ждать Приостановить(Задержка);                 // Асинх/Ждать — диалект
  Возврат "готово";
КонецФункции

Асинх Процедура ПроверитьАсинхронность()
  Результат = Ждать ЗагрузитьДанные(1);
  Сообщить(Результат);
КонецПроцедуры

#КонецОбласти

#Область НовыеОбъектыИСкобки

Процедура ПроверитьНовыеОбъекты()
  Массив = Новый Массив;                         // тип без полей/методов у полей
  Массив.Добавить(1);
  Массив.Добавить(2);
  Значение = Массив[0] + Массив[1];              // индексация
  Уникальный = Новый УникальныйИдентификатор;    // раньше давал ложный OSJS3003
  Структура = Новый Структура("Ключ", Значение);
  Сообщить(Строка(Уникальный) + " " + Структура.Ключ);
КонецПроцедуры

#КонецОбласти

#Область EDGE_Кириллица_и_идентификаторы

// Двойной клик должен выделять кириллические слова целиком:
// Проверить_Слово1, Слово2, ЭтоДлинноеИмя
Процедура Проверить_Слово1(Слово2 = 1)
  ЭтоДлинноеИмя = Слово2;
  Сообщить(ЭтоДлинноеИмя);
КонецПроцедуры

#КонецОбласти

// Подсказки/диагностика:
// - набрать «Сооб» → completion «Сообщить»/«Message»;
// - hover на «Сообщить(» — сигнатура;
// - gd на «Проверить_Слово1» — переход к объявлению;
// - Outline (gO/:lua vim.lsp.buf.document_symbol()) — регионы/методы;
// - ошибку можно проверить, добавив «Х = 1 +;» (появится OSJS2001).
