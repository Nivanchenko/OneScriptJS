// Лексика .osjs (FR-002): ключевые слова, операторы, константы, строки, даты, директивы.
#Область Демонстрация
#Если Сервер Тогда
#Использовать "Модуль"

&Аннотация
Асинх Функция Тест(Знач Параметр) Экспорт
    Перем Счётчик, Значение;
    Если Параметр = Истина Тогда
        Сообщить("однострочная строка");
    ИначеЕсли Параметр = Ложь Тогда
        Строка = "первая часть
        |вторая часть
        |третья часть";
    Иначе
        Строка = "экранирование ""кавычек""";
    КонецЕсли;
    Флаг = Истина И Ложь Или Не Истина;
    EnglishFlag = True And False Or Not True;
    Для Каждого Элемент Из Массив Цикл
        Пока Счётчик < 10 Цикл
            Счётчик = Счётчик + 1; // хвостовой комментарий
        КонецЦикла;
        Продолжить;
    КонецЦикла;
    Попытка
        ВызватьИсключение "ошибка";
    Исключение
        Выполнить("Ждать");
    КонецПопытки;
    Объект = Новый Массив;
    Дата = '20260101';
    Число = 42.5;
    Пусто = Неопределено;
    Ждать Тест();
    ДобавитьОбработчик(Обработка, "Имя");
    УдалитьОбработчик(Обработка, "Имя");
    Goto ~Метка;
    Execute("Goto");
    Async Function English(Val Param) Export
        Await Test();
        AddHandler(Handler, "Name");
        RemoveHandler(Handler, "Name");
    EndFunction
    Перейти ~Метка;
    Возврат Неопределено;
КонецФункции

&СПараметрами(Х = 1)
Процедура БезПараметров()
КонецПроцедуры

