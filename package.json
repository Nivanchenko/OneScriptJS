{
  "name": "onescriptjs",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "OneScript — движок языка 1С/BSL, переписанный на TypeScript. Работает в Node.js и в браузере.",
  "license": "MIT",
  "author": "Nikita Ivanchenko",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/node/index.cjs",
  "module": "./dist/node/index.js",
  "types": "./dist/node/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js",
      "require": "./dist/node/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "typecheck:vscode": "tsc -p extensions/vscode/tsconfig.json --noEmit",
    "build:browser": "vite build",
    "build:node": "vite build --config vite.node.config.ts && tsc -p tsconfig.build.json",
    "build:cli": "vite build --config vite.cli.config.ts",
    "build:lsp": "vite build --config vite.lsp.config.ts",
    "build:vscode": "node scripts/build-vscode-extension.mjs",
    "build:catalog": "node scripts/build-api-catalog.mjs",
    "build": "tsc --noEmit && vite build && vite build --config vite.node.config.ts && vite build --config vite.cli.config.ts && tsc -p tsconfig.build.json && vite build --config vite.lsp.config.ts",
    "oscript": "node dist/cli.mjs",
    "lsp": "node dist/lsp/server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "vite build && node scripts/copy-examples.mjs && vite preview --port 4173 --open /",
    "check:docs": "node scripts/check-api-docs.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/vscode": "1.91.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7",
    "vscode-jsonrpc": "10.0.0",
    "vscode-languageclient": "11.0.0",
    "vscode-languageserver": "11.0.0",
    "vscode-languageserver-textdocument": "1.0.16",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
